# Domain name pointing at this server; use "localhost" to try the stack locally.
TIROIR_DOMAIN=localhost
# E-mail address given to the certificate authority (expiry notices).
TIROIR_ACME_EMAIL=admin@example.com
# Image tag to run.
TIROIR_TAG=latest
# Private subnet of the stack's network, where Caddy runs; tiroir believes the
# client addresses it forwards from there only. Change it if it clashes.
TIROIR_PROXY_SUBNET=172.30.80.0/24
